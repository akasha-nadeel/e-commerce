# --- Shopify Storefront API (headless catalog + cart) ---
# Copy this file to `.env.local` and fill in real values.
#
# In Shopify admin: Settings -> Apps and sales channels -> Develop apps ->
# create an app -> Configure Storefront API scopes -> Install -> copy the
# "Storefront API access token" (this token is public-safe / read-only).

# Your store domain, e.g. golden-egal.myshopify.com (NOT the custom domain).
SHOPIFY_STORE_DOMAIN=

# Storefront API access token (public). Kept server-side (not NEXT_PUBLIC_).
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Storefront API version — quarterly (YYYY-MM). Use a currently supported one.
SHOPIFY_API_VERSION=2025-10

# --- Customer Account API (passwordless login via Shopify's hosted OAuth) ---
# In Shopify admin: install the "Headless" sales channel -> your storefront ->
# Customer Account API -> Manage. Register callback URIs (/api/auth/callback),
# JS origins and logout URIs; copy the Client ID and Shop ID (in the endpoints).
SHOPIFY_CUSTOMER_ACCOUNT_SHOP_ID=
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_API_VERSION=2025-10

# --- Admin API (server-only) — custom product reviews (metaobjects) ---
# Settings -> Apps and sales channels -> Develop apps -> create app -> Admin API
# scopes: read/write_metaobjects, read/write_metaobject_definitions, read_products
# -> Install -> copy the Admin API access token (shpat_...). SECRET — never expose.
# Run once: node scripts/setup-reviews-metaobject.mjs (creates the definition).
SHOPIFY_ADMIN_ACCESS_TOKEN=

# --- Studio (/studio) — the simplified product manager for the store owner ---
# Passphrase for signing in. This surface writes to the live store with the
# Admin token above, so treat it like a store password: long, random, and
# shared with the owner only. Unset = /studio 404s (it never opens
# unauthenticated). Changing this value signs everyone out immediately.
#
# Stock quantities additionally need `read_locations` + `write_inventory` on the
# Admin app; without them products still save, but stock numbers don't.
STUDIO_PASSWORD=
